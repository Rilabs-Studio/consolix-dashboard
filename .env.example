# Copy to .env and adjust.
#
# This dashboard is a pure admin UI for the NestJS backend (../consolix-backend).
# It has no database of its own — every page reads/writes via the NestJS API.

# NestJS API base URL.
#  - API_URL is used by server components / server actions (server-to-server).
#  - NEXT_PUBLIC_API_URL is the browser-visible value (Socket.IO /live on the
#    cashier page derives its origin from this by stripping the /v1 suffix).
API_URL="http://localhost:3000/v1"
NEXT_PUBLIC_API_URL="http://localhost:3000/v1"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true

# Go RDMS backend (../consolix-tv) — TV rental timers.
#  - RDMS_API_URL is server-side only (RSC/Server Actions). The Go API has no
#    auth of its own, so NEVER expose it publicly — keep it on localhost or a
#    private network.
#  - NEXT_PUBLIC_RDMS_WS_URL is the browser-visible WebSocket for the live
#    board (wss://your-domain/ws behind nginx in production).
RDMS_API_URL="http://localhost:8080"
NEXT_PUBLIC_RDMS_WS_URL="ws://localhost:8080/ws"
